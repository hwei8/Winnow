# ── 必填：LLM（抽取 / 成稿 / 简报文案）──────────────────────────────────
# opencode-go（兼容 OpenAI 协议）。也可放 .secrets/opencode-go.key，或回落到 ~/.dsh/.credentials.yaml
OPENCODE_GO_API_KEY=
# LLM_CHAT_MODEL=deepseek-v4.1-flash

# ── 必填：Embedding（向量召回）─────────────────────────────────────────
# 默认走 OpenRouter 的 baai/bge-m3（1024 维）
OPENROUTER_API_KEY=
# EMBED_PROVIDER=openrouter        # 或 local
# EMBED_BASE_URL=http://127.0.0.1:8033/v1/embeddings
# EMBED_MODEL=bge-m3

# ── 必填：Jev 决策模型（判定"是否同一事件"）─────────────────────────────
# Zen 免费通道优先，OpenRouter 自动兜底
ZEN_API_KEY=
# JEV_PROVIDER=zen
# JEV_FALLBACK=1

# ── 可选：搜索与正文兜底（DeepSeek 官方搜索 API）───────────────────────
DEEPSEEK_SEARCH_TOKEN=
# DEEPSEEK_SEARCH_QPS=5

# ── 可选：Telegram 推送（也可用 .secrets/telegram.json：{"bot_token","chat_id"}）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 可选：路径与端口 ───────────────────────────────────────────────────
# WINNOW_DB=data/winnow.db
# WINNOW_DATA_DIR=data
# WINNOW_OUT_DIR=out
# 默认只监听本机。暴露到局域网（HOST=0.0.0.0）时必须设置 WINNOW_WEB_TOKEN。
# HOST=127.0.0.1
# PORT=3083
# WINNOW_WEB_TOKEN=
# WINNOW_ALLOWED_HOSTS=winnow.example.com     # 反代 / 自定义域名时追加允许的 Host
# WINNOW_PUBLIC_URL=https://winnow.example.com # 简报里 Story 链接的前缀
# WINNOW_TZ=Asia/Shanghai                     # 简报 / 日报的日期时区
# WINNOW_ALLOW_PRIVATE_FETCH=1                # 允许抓取内网地址（默认禁止，仅本地调试）
