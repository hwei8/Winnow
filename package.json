{
  "name": "winnow",
  "version": "0.1.0",
  "private": true,
  "description": "个人记忆与信息过滤系统：把新闻洪流折叠成可读的 Story，记住你想记的东西。",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "web": "node src/web/server.mjs",
    "start": "node src/web/server.mjs",
    "health": "node src/cli/health.mjs",
    "pipeline": "node src/cli/pipeline.mjs",
    "collect": "node src/cli/collect.mjs",
    "brief": "node src/cli/brief.mjs",
    "daemon": "node src/cli/daemon.mjs",
    "worker": "node src/cli/worker.mjs",
    "realign": "node src/cli/realign.mjs",
    "db:init": "node src/cli/db.mjs --init",
    "db:stats": "node src/cli/db.mjs --stats",
    "db:backup": "node src/cli/db.mjs --backup",
    "db:repair": "node src/cli/db.mjs --repair",
    "test": "node --test tests/*.test.mjs",
    "check": "node tests/check-syntax.mjs",
    "bench:build": "node src/cli/bench-build.mjs",
    "label": "node src/cli/label.mjs",
    "bench": "node src/cli/bench.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hwei8/Winnow.git"
  },
  "keywords": [
    "personal-memory",
    "information-filter",
    "news-pipeline",
    "story-generation",
    "deduplication",
    "sqlite",
    "llm"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hwei8/Winnow/issues"
  },
  "homepage": "https://github.com/hwei8/Winnow#readme"
}
