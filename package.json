{
  "name": "winnow",
  "version": "0.1.0",
  "private": true,
  "description": "个人记忆与信息过滤系统：把新闻洪流折叠成可读的 Story，记住你想记的东西。",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "web": "node src/web/server.mjs",
    "start": "node src/web/server.mjs",
    "health": "node src/cli/health.mjs",
    "pipeline": "node src/cli/pipeline.mjs",
    "collect": "node src/cli/collect.mjs",
    "brief": "node src/cli/brief.mjs",
    "daemon": "node src/cli/daemon.mjs",
    "db:init": "node src/cli/db.mjs --init",
    "db:stats": "node src/cli/db.mjs --stats",
    "db:backup": "node src/cli/db.mjs --backup",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/winnow.git"
  },
  "keywords": [
    "personal-memory",
    "information-filter",
    "news-pipeline",
    "story-generation",
    "deduplication",
    "sqlite",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "bugs": {
    "url": "https://github.com/OWNER/winnow/issues"
  },
  "homepage": "https://github.com/OWNER/winnow#readme"
}
